# Copy this file to .env (same folder as docker-compose.yml) and fill in what you need.

# Optional. Without a key the app shows a simple built-in map instead of Google Maps.
# Get one at https://console.cloud.google.com/google/maps-apis (enable "Maps JavaScript API").
GOOGLE_MAPS_API_KEY=

# City the simulated drivers drive around in (default: Bengaluru)
CITY_CENTER_LAT=12.9716
CITY_CENTER_LNG=77.5946

# Simulated drivers so you can try the app with one browser tab
SIMULATOR_ENABLED=true
SIMULATOR_BOTS=6

# Shared secret used to sign JWTs (must be at least 32 characters)
JWT_SECRET=rideflow-demo-secret-key-change-me-in-production-0123456789
